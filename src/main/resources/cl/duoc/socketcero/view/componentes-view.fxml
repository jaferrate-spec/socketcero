<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600" prefWidth="800" style="-fx-background-color: white;" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <Pane prefHeight="600.0" prefWidth="150.0" style="-fx-background-color: #1887db;" BorderPane.alignment="CENTER">
            <children>
                <Button layoutX="12.0" layoutY="80.0" mnemonicParsing="false" prefWidth="125.0" styleClass="boton-nav" text="Inicio">
                    <font>
                        <Font name="Franklin Gothic Medium" size="12.0" />
                    </font>
                </Button>
                <Button layoutX="12.0" layoutY="140.0" mnemonicParsing="false" prefWidth="125.0" styleClass="boton-nav" text="Componentes">
                    <font>
                        <Font name="Franklin Gothic Medium" size="12.0" />
                    </font>
                </Button>
                <Button layoutX="12.0" layoutY="200" mnemonicParsing="false" prefWidth="125.0" styleClass="boton-nav" text="Proovedores">
                    <font>
                        <Font name="Franklin Gothic Medium" size="12.0" />
                    </font>
                </Button>
                <Label layoutX="22.0" layoutY="14.0" text="SocketCero" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </Pane>
    </left>
    <center>
        <Pane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="23.0" layoutY="81.0" prefHeight="20.0" prefWidth="142.0" text="Tipo de componente:">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label layoutX="14.0" layoutY="14.0" prefHeight="17.0" prefWidth="313.0" text="Inicio">
                    <font>
                        <Font name="Inter Regular" size="18.0" />
                    </font>
                </Label>
                <ComboBox layoutX="171.0" layoutY="79.0" prefWidth="150.0" styleClass="combo-box-base"/>
                <TableView layoutX="23.0" layoutY="115.0" prefHeight="404.0" prefWidth="603.0">
                    <columns>
                        <TableColumn prefWidth="75.0" text="Codigo" />
                        <TableColumn prefWidth="75.0" text="Nombre" />
                        <TableColumn prefWidth="75.0" text="Marca" />
                        <TableColumn prefWidth="75.0" text="Precio" />
                        <TableColumn prefWidth="75.0" text="Stock" />
                        <TableColumn prefWidth="75.0" text="Fecha Lanzamiento" />
                        <TableColumn prefWidth="75.0" text="Info Adicional" visible="false" />
                        <TableColumn prefWidth="75.0" text="Info Adicional 2" visible="false" />
                        <TableColumn prefWidth="75.0" text="Info Adicional 3" visible="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Button layoutX="350.0" layoutY="79.0" mnemonicParsing="false" text="Registrar Componente" styleClass="boton-pane" />
                <Button layoutX="35.0" layoutY="525.0" mnemonicParsing="false" text="Eliminar Componente" styleClass="boton-pane"/>
                <Button layoutX="171.0" layoutY="525.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="95.0" text="Modificar" styleClass="boton-pane" />
            </children>
        </Pane>
    </center>
</BorderPane>
